#!/usr/bin/env bash
# fssh_refactor.sh
# Refactored Enhanced SSH host selector
# Features:
# - fzf fuzzy finder (optional, auto used when available)
# - history weighting (hosts used more often float up)
# - preview host details (HostName) in fzf preview
# - auto-ping before ssh (optional)
# - reconnection logic with full menu reprint
# - graceful fallbacks when fzf not available
# - supports options: -i (case-insensitive), -l (list-only), -a (show-all), -d (details), -f (force fzf), -p (pre-ping), -h (help)

set -euo pipefail
IFS=$'\n\t'

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Defaults
SSH_CONFIG="$HOME/.ssh/config"
HISTORY_FILE="$HOME/.fssh_history"
MAX_HISTORY=50
USE_FZF_AUTO=true
FORCE_FZF=false
PRE_PING=false
CASE_INSENSITIVE=false
LIST_ONLY=false
SHOW_ALL=false
SHOW_DETAILS=false
SUBSTRING=""

print_help() {
    cat <<EOF
Usage: $(basename "$0") [-i] [-l] [-a] [-d] [-f] [-p] [-h] <substring>
  -i  Case-insensitive search
  -l  List matches only (don't connect)
  -a  Show all hosts
  -d  Show details (HostName/IP)
  -f  Force fzf (fail if not available)
  -p  Pre-ping host before attempting ssh
  -h  Show this help

Examples:
  $(basename "$0") -i jenkins
  $(basename "$0") -a
  $(basename "$0") -f supeng
EOF
}

# Parse args
while getopts ":iladfph" opt; do
    case $opt in
        i) CASE_INSENSITIVE=true ;;
        l) LIST_ONLY=true ;;
        a) SHOW_ALL=true ;;
        d) SHOW_DETAILS=true ;;
        f) FORCE_FZF=true ;;
        p) PRE_PING=true ;;
        h) print_help; exit 0 ;;
        :) echo "Missing option argument for -$OPTARG" >&2; exit 1 ;;
        \?) echo "Unknown option -$OPTARG" >&2; print_help; exit 1 ;;
    esac
done
shift $((OPTIND-1))

# Substring if provided
if [ $# -gt 0 ]; then
    SUBSTRING="$1"
fi

# Validate files
if [ ! -f "$SSH_CONFIG" ]; then
    echo -e "${RED}Error: SSH config not found at $SSH_CONFIG${NC}"
    exit 1
fi

# Ensure history file exists
mkdir -p "$(dirname "$HISTORY_FILE")"
: >| "$HISTORY_FILE" 2>/dev/null || true

# Utility: get host list
get_hosts_raw() {
    awk '$1 == "Host" && $2 !~ /\*/ {print $2}' "$SSH_CONFIG"
}

get_hosts_filtered() {
    if [ "$SHOW_ALL" = true ]; then
        get_hosts_raw
        return
    fi

    if [ -z "$SUBSTRING" ]; then
        get_hosts_raw
        return
    fi

    if [ "$CASE_INSENSITIVE" = true ]; then
        awk -v pat="$SUBSTRING" 'BEGIN{IGNORECASE=1} $1=="Host" && $2 !~ /\*/ && $2 ~ pat {print $2}' "$SSH_CONFIG"
    else
        awk -v pat="$SUBSTRING" '$1=="Host" && $2 !~ /\*/ && $2 ~ pat {print $2}' "$SSH_CONFIG"
    fi
}

# Get details HostName for preview
get_host_hostname() {
    local h="$1"
    awk -v h="$h" '
        $1=="Host" && $2==h {found=1; next}
        found && $1=="HostName" {print $2; exit}
        found && $1=="Host" {exit}
    ' "$SSH_CONFIG"
}

# Weighted sorting by history
# History file format: host|count (tab-separated or pipe), fallback to plain host lines if old
increment_history() {
    local host="$1"
    declare -A counts
    # read existing
    if [ -f "$HISTORY_FILE" ] && [ -s "$HISTORY_FILE" ]; then
        while IFS='|' read -r hh cnt; do
            if [ -z "$cnt" ]; then
                # old style: just host lines
                counts["$hh"]=$((counts["$hh"]+1))
            else
                counts["$hh"]=$cnt
            fi
        done < "$HISTORY_FILE"
    fi
    counts["$host"]=$(( ${counts["$host"]:-0} + 1 ))
    # write back sorted by count desc
    >"${HISTORY_FILE}.tmp"
    for k in "${!counts[@]}"; do
        echo "$k|${counts[$k]}" >> "${HISTORY_FILE}.tmp"
    done
    # sort numerically by second field desc
    sort -t'|' -k2,2nr "${HISTORY_FILE}.tmp" > "$HISTORY_FILE"
    rm -f "${HISTORY_FILE}.tmp"
}

# Produce weighted host list: hosts that appear in history higher
produce_weighted_list() {
    local -a raw
    mapfile -t raw < <(get_hosts_filtered)

    # read history into order
    declare -A rank
    local idx=0
    if [ -f "$HISTORY_FILE" ]; then
        while IFS='|' read -r hh cnt; do
            rank["$hh"]=$((100000 - idx))
            idx=$((idx+1))
        done < "$HISTORY_FILE"
    fi

    # prepare sortable lines: score<tab>host
    for h in "${raw[@]}"; do
        score=${rank["$h"]:-0}
        echo -e "$score\t$h"
    done | sort -k1,1nr | awk -F"\t" '{print $2}'
}

# Check fzf availability
has_fzf() {
    command -v fzf >/dev/null 2>&1
}

# Ping host helper
ping_host() {
    local target="$1"
    # try HostName first
    local hn
    hn=$(get_host_hostname "$target")
    local ip_or_host=${hn:-$target}
    if ping -c 1 -W 1 "$ip_or_host" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# Interactive menu using fzf or fallback
interactive_menu() {
    local options
    mapfile -t options < <(produce_weighted_list)

    # Inject details when -d enabled (for select fallback)
    if [ "$SHOW_DETAILS" = true ]; then
        new_opts=()
        for host in "${options[@]}"; do
            d=$(get_host_hostname "$host")
            new_opts+=("$host (${d:-unknown})")
        done
        options=("${new_opts[@]}")
    fi

    if [ ${#options[@]} -eq 0 ]; then
        echo -e "${YELLOW}No matching hosts found for: ${SUBSTRING}${NC}"
        exit 1
    fi

    if [ "$LIST_ONLY" = true ]; then
        echo -e "${GREEN}Found ${#options[@]} matching host(s):${NC}"
        local i=1
        for h in "${options[@]}"; do
            if [ "$SHOW_DETAILS" = true ]; then
                d=$(get_host_hostname "$h")
                printf "${BLUE}%2d)${NC} %-30s ${YELLOW}(%s)${NC}\n" $i "$h" "${d:--}"
            else
                echo -e "${BLUE}$i)${NC} $h"
            fi
            ((i++))
        done
        exit 0
    fi

    # If fzf is available and either auto or forced
    if has_fzf || [ "$FORCE_FZF" = true ]; then
        if ! has_fzf && [ "$FORCE_FZF" = true ]; then
            echo -e "${RED}fzf forced but not found. Install fzf or remove -f.${NC}"
            exit 1
        fi

        # Build preview command showing HostName
        preview_cmd='awk -v h="{+1}" '\''$1=="Host" && $2==h {found=1; next} found { if($1=="HostName") print "HostName: "$2; if($1=="User") print "User: "$2; if($1=="Port") print "Port: "$2; if($1=="ProxyJump") print "ProxyJump: "$2; if($1=="Host") exit }'\'' "$SSH_CONFIG"'
        # But we need to pass the selected host into preview; use fzf --preview with a small wrapper

        # Create an input stream for fzf
        selected=""
        while true; do
            selected=$(printf "%s\n" "${options[@]}" | fzf --ansi --prompt "${BLUE}Select host: ${NC}" --preview "awk -v h=\"{}\" '\$1==\"Host\" && \$2==h {found=1; next} found { if(\$1==\"HostName\") print \"HostName: \"\$2; if(\$1==\"User\") print \"User: \"\$2; if(\$1==\"Port\") print \"Port: \"\$2; if(\$1==\"ProxyJump\") print \"ProxyJump: \"\$2; if(\$1==\"Host\") exit }' $SSH_CONFIG" --height 40% --layout=reverse --border)

            if [ -z "$selected" ]; then
                # user pressed ESC or cancelled
                echo "Cancelled."
                exit 0
            fi

            # selected is host name (line content)
            selected_host="$selected"
            attempt_connect_loop "$selected_host" || true
            # If attempt_connect_loop returned with successful exit, script will have exited.
            # Otherwise, user chose to try another host -> continue loop to show fzf again
        done

    else
        # Fallback: menu using select and while loop (TTY required)
        echo -e "${GREEN}Found ${#options[@]} matching hosts:${NC}"
        printf -v PS3 $'\n'"${BLUE}"'Select host (or '\''q'\'' to quit): '"${NC}"

        while true; do
            select opt in "${options[@]}"; do
                if [[ "$REPLY" =~ ^[Qq]$ ]]; then
                    echo "Cancelled."; exit 0
                fi
                if [ -z "$opt" ]; then
                    echo -e "${RED}Invalid option. Please try again.${NC}"
                    continue
                fi
                selected_host=$(echo "$opt" | sed 's/ (.*//')
                attempt_connect_loop "$selected_host" || true
                # if user asked to try another host, break select to reprint menu
                break
            done
        done
    fi
}

# Loop for connection attempts and reconnect logic
attempt_connect_loop() {
    local selected_host="$1"
    while true; do
        echo -e "${GREEN}Connecting to: ${selected_host}${NC}"

        # Pre-ping
        if [ "$PRE_PING" = true ]; then
            if ping_host "$selected_host"; then
                echo -e "${YELLOW}Ping ok.${NC}"
            else
                echo -e "${YELLOW}Ping failed or timed out.${NC}"
            fi
        fi

        ssh "$selected_host"
        exit_code=$?

        if [ $exit_code -eq 0 ]; then
            # success
            increment_history "$selected_host"
            return 0
        fi

        echo -e "${RED}Connection failed (exit code: $exit_code)${NC}"
        # offer options: try another host, retry same, or quit
        read -r -p "[r]etry, [a]nother host, [q]uit? (r/a/q): " choice
        case "$choice" in
            r|R)
                echo "Retrying $selected_host..."
                continue
                ;;
            a|A)
                # try another host -> return non-zero so caller will show menu again
                return 1
                ;;
            q|Q)
                exit $exit_code
                ;;
            *)
                echo "Invalid choice. Exiting."; exit $exit_code
                ;;
        esac
    done
}

# Main
interactive_menu

# End of script
