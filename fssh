#!/usr/bin/env bash
# fssh_refactor.sh
# Refactored Enhanced SSH host selector
# Features:
# - fzf fuzzy finder (optional, auto used when available)
# - history weighting (hosts used more often float up)
# - preview host details (HostName) in fzf preview
# - auto-ping before ssh (optional)
# - reconnection logic with full menu reprint
# - graceful fallbacks when fzf not available
# - supports options: -i (case-insensitive), -l (list-only), -a (show-all), -d (details), -f (force fzf), -p (pre-ping), -h (help)

set -euo pipefail
IFS=$'\n\t'

# Colors (Fixed to use ANSI C-quoting for proper raw byte evaluation in prompts)
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
BLUE=$'\033[0;34m'
CYAN=$'\033[0;36m'
MAGENTA=$'\033[0;35m'
GRAY=$'\033[0;90m'
WHITE=$'\033[1;37m'
BOLD=$'\033[1m'
NC=$'\033[0m'

# Defaults
SSH_CONFIG="$HOME/.ssh/config"
HISTORY_FILE="$HOME/.fssh_history"
MAX_HISTORY=50
USE_FZF_AUTO=true
FORCE_FZF=false
PRE_PING=false
CASE_INSENSITIVE=false
LIST_ONLY=false
SHOW_ALL=false
SHOW_DETAILS=false
SUBSTRING=""
ACTION_SAME_LIST=0
ACTION_NEW_SEARCH=10

get_now() {
    date '+%Y-%m-%d %H:%M:%S %Z'
}

print_divider() {
    printf "%b%s%b\n" "$GRAY" "============================================================" "$NC"
}

print_banner() {
    local mode_label search_label

    mode_label="FILTER"
    search_label="${SUBSTRING:-ALL}"

    if [ "$SHOW_ALL" = true ]; then
        mode_label="ALL"
    fi

    print_divider
    echo -e "${CYAN}${BOLD}FSSH // FIELD SSH CONSOLE${NC}"
    echo -e "${GRAY}[$(get_now)]${NC}"
    echo -e "${WHITE}MODE${NC}   : ${CYAN}${mode_label}${NC}"
    echo -e "${WHITE}QUERY${NC}  : ${YELLOW}${search_label}${NC}"
    echo -e "${WHITE}DETAIL${NC} : ${YELLOW}$([ "$SHOW_DETAILS" = true ] && echo ENABLED || echo DISABLED)${NC}"
    print_divider
}

format_status_label() {
    local status="$1"

    case "$status" in
        SSH-READY) printf "%b%s%b" "$GREEN" "$status" "$NC" ;;
        ICMP-OK) printf "%b%s%b" "$CYAN" "$status" "$NC" ;;
        PROBING) printf "%b%s%b" "$YELLOW" "$status" "$NC" ;;
        PORT-CLOSED|TIMEOUT) printf "%b%s%b" "$YELLOW" "$status" "$NC" ;;
        NO-ROUTE|DNS-FAIL|UNREACHABLE|UNKNOWN) printf "%b%s%b" "$RED" "$status" "$NC" ;;
        *) printf "%s" "$status" ;;
    esac
}

print_section_title() {
    local title="$1"
    echo -e "${MAGENTA}${BOLD}:: ${title}${NC}"
}

print_help() {
    cat <<EOF
Usage: $(basename "$0") [-i] [-l] [-a] [-d] [-f] [-p] [-h] <substring>
  -i  Case-insensitive search
  -l  List matches only (don't connect)
  -a  Show all hosts
  -d  Show details (HostName/IP + live network status)
  -f  Force fzf (fail if not available)
  -p  Pre-ping host before attempting ssh
  -h  Show this help

This script also prints:
  - Current outbound IP address
  - Internet connectivity status

Examples:
  $(basename "$0") -i jenkins
  $(basename "$0") -a
  $(basename "$0") -f supeng
EOF
}

# Parse args
while getopts ":iladfph" opt; do
    case $opt in
        i) CASE_INSENSITIVE=true ;;
        l) LIST_ONLY=true ;;
        a) SHOW_ALL=true ;;
        d) SHOW_DETAILS=true ;;
        f) FORCE_FZF=true ;;
        p) PRE_PING=true ;;
        h) print_help; exit 0 ;;
        :) echo "Missing option argument for -$OPTARG" >&2; exit 1 ;;
        \?) echo "Unknown option -$OPTARG" >&2; print_help; exit 1 ;;
    esac
done
shift $((OPTIND-1))

# Substring if provided
if [ $# -gt 0 ]; then
    SUBSTRING="$1"
fi

# Validate files
if [ ! -f "$SSH_CONFIG" ]; then
    echo -e "${RED}Error: SSH config not found at $SSH_CONFIG${NC}"
    exit 1
fi

# Ensure history file exists
mkdir -p "$(dirname "$HISTORY_FILE")"
: >| "$HISTORY_FILE" 2>/dev/null || true

# Utility: get host list
get_hosts_raw() {
    awk '$1 == "Host" && $2 !~ /\*/ {print $2}' "$SSH_CONFIG"
}

get_hosts_filtered() {
    if [ "$SHOW_ALL" = true ]; then
        get_hosts_raw
        return
    fi

    if [ -z "$SUBSTRING" ]; then
        get_hosts_raw
        return
    fi

    if [ "$CASE_INSENSITIVE" = true ]; then
        awk -v pat="$SUBSTRING" 'BEGIN{IGNORECASE=1} $1=="Host" && $2 !~ /\*/ && $2 ~ pat {print $2}' "$SSH_CONFIG"
    else
        awk -v pat="$SUBSTRING" '$1=="Host" && $2 !~ /\*/ && $2 ~ pat {print $2}' "$SSH_CONFIG"
    fi
}

# Get details HostName for preview
get_host_hostname() {
    local h="$1"
    awk -v h="$h" '
        $1=="Host" && $2==h {found=1; next}
        found && $1=="HostName" {print $2; exit}
        found && $1=="Host" {exit}
    ' "$SSH_CONFIG"
}

get_host_port() {
    local h="$1"
    awk -v h="$h" '
        $1=="Host" && $2==h {found=1; next}
        found && $1=="Port" {print $2; exit}
        found && $1=="Host" {exit}
    ' "$SSH_CONFIG"
}

# Weighted sorting by history
# History file format: host|count (tab-separated or pipe), fallback to plain host lines if old
increment_history() {
    local host="$1"
    declare -A counts
    # read existing
    if [ -f "$HISTORY_FILE" ] && [ -s "$HISTORY_FILE" ]; then
        while IFS='|' read -r hh cnt; do
            if [ -z "$cnt" ]; then
                # old style: just host lines
                counts["$hh"]=$((counts["$hh"]+1))
            else
                counts["$hh"]=$cnt
            fi
        done < "$HISTORY_FILE"
    fi
    counts["$host"]=$(( ${counts["$host"]:-0} + 1 ))

    # write back sorted by count desc
    >"${HISTORY_FILE}.tmp"
    for k in "${!counts[@]}"; do
        echo "$k|${counts[$k]}" >> "${HISTORY_FILE}.tmp"
    done
    # sort numerically by second field desc
    sort -t'|' -k2,2nr "${HISTORY_FILE}.tmp" > "$HISTORY_FILE"
    rm -f "${HISTORY_FILE}.tmp"
}

# Produce weighted host list: hosts that appear in history higher
produce_weighted_list() {
    local -a raw
    mapfile -t raw < <(get_hosts_filtered)

    # read history into order
    declare -A rank
    local idx=0
    if [ -f "$HISTORY_FILE" ]; then
        while IFS='|' read -r hh cnt; do
            rank["$hh"]=$((100000 - idx))
            idx=$((idx+1))
        done < "$HISTORY_FILE"
    fi

    # prepare sortable lines: score<tab>host
    for h in "${raw[@]}"; do
        score=${rank["$h"]:-0}
        echo -e "$score\t$h"
    done | sort -k1,1nr | awk -F"\t" '{print $2}'
}

# Check fzf availability
has_fzf() {
    command -v fzf >/dev/null 2>&1
}

# Ping host helper
ping_host() {
    local target="$1"
    # try HostName first
    local hn
    hn=$(get_host_hostname "$target")
    local ip_or_host=${hn:-$target}
    if ping -c 1 -W 1 "$ip_or_host" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

get_host_target() {
    local host="$1"
    local hn

    hn=$(get_host_hostname "$host")
    echo "${hn:-$host}"
}

get_reachability_status() {
    local host="$1"
    local target port probe_output

    target=$(get_host_target "$host")
    port=$(get_host_port "$host")
    port=${port:-22}

    if command -v nc >/dev/null 2>&1; then
        probe_output=$(nc -z -w 1 "$target" "$port" 2>&1 >/dev/null)
        if [ $? -eq 0 ]; then
            echo "SSH-READY"
            return
        fi

        case "$probe_output" in
            *"Connection refused"*)
                echo "PORT-CLOSED"
                return
                ;;
            *"No route to host"*|*"Network is unreachable"*)
                echo "NO-ROUTE"
                return
                ;;
            *"timed out"*|*"Operation timed out"*)
                echo "TIMEOUT"
                return
                ;;
            *"Name or service not known"*|*"Temporary failure in name resolution"*|*"nodename nor servname provided, or not known"*)
                echo "DNS-FAIL"
                return
                ;;
        esac
    fi

    if command -v ping >/dev/null 2>&1; then
        if ping -c 1 -W 1 "$target" >/dev/null 2>&1; then
            echo "ICMP-OK"
            return
        fi
    fi

    echo "UNREACHABLE"
}

is_connectable_status() {
    local status="$1"

    case "$status" in
        SSH-READY|ICMP-OK)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

format_host_option() {
    local host="$1"
    local status="${2:-}"
    local target rendered_status

    if [ "$SHOW_DETAILS" = true ]; then
        target=$(get_host_target "$host")
        if [ -n "$status" ]; then
            rendered_status=$(format_status_label "$status")
            printf "%s %b(%s)%b %b[%s]%b\n" "$host" "$GRAY" "${target:-unknown}" "$NC" "$BOLD" "$rendered_status" "$NC"
        else
            printf "%s %b(%s)%b\n" "$host" "$GRAY" "${target:-unknown}" "$NC"
        fi
    else
        echo "$host"
    fi
}

extract_host_name() {
    local entry="$1"

    entry="${entry%% *}"
    echo "$entry"
}

get_current_ip() {
    local current_ip=""

    if command -v ip >/dev/null 2>&1; then
        current_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '
            /src/ {
                for (i = 1; i <= NF; i++) {
                    if ($i == "src" && (i + 1) <= NF) {
                        print $(i + 1)
                        exit
                    }
                }
            }'
        )
    fi

    if [ -z "$current_ip" ] && command -v hostname >/dev/null 2>&1; then
        current_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi

    if [ -z "$current_ip" ] && command -v ifconfig >/dev/null 2>&1; then
        current_ip=$(ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" {print $2; exit}')
    fi

    echo "${current_ip:-unknown}"
}

has_internet_connection() {
    if command -v ping >/dev/null 2>&1; then
        ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1 && return 0
        ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 && return 0
    fi

    return 1
}

print_network_status() {
    local current_ip internet_status internet_color

    current_ip=$(get_current_ip)

    if has_internet_connection; then
        internet_status="Connected"
        internet_color="$GREEN"
    else
        internet_status="Not connected"
        internet_color="$RED"
    fi

    print_section_title "SESSION"
    echo -e "${WHITE}Current IP${NC} : ${CYAN}${current_ip}${NC}"
    echo -e "${WHITE}Internet  ${NC} : ${internet_color}${internet_status}${NC}"
    echo
}

print_host_list() {
    local title="$1"
    shift
    local i=1

    print_section_title "$title"
    for h in "$@"; do
        printf "%b%2d)%b %b\n" "$BLUE" "$i" "$NC" "$h"
        ((i++))
    done
}

print_actions_menu() {
    local title="$1"
    shift

    echo
    echo -e "${WHITE}${title}${NC}"
    for action in "$@"; do
        echo -e "$action"
    done
}

read_actions_choice() {
    local prompt_label="${1:-select}"
    local choice

    printf "%b" "${CYAN}${prompt_label}> ${NC}" >&2
    read -r choice
    echo "$choice"
}

prompt_new_search() {
    local new_search

    echo
    printf "%b" "${CYAN}client-search> ${NC}"
    read -r new_search
    SUBSTRING="$new_search"
    SHOW_ALL=false
    if [ -z "$SUBSTRING" ]; then
        SHOW_ALL=true
    fi
}

handle_post_disconnect() {
    local choice

    print_actions_menu "Actions:" \
        "[l] back to current list" \
        "[s] search again" \
        "[q] quit"
    choice=$(read_actions_choice "next-action")
    case "$choice" in
        l|L|"")
            return "$ACTION_SAME_LIST"
            ;;
        s|S)
            prompt_new_search
            return "$ACTION_NEW_SEARCH"
            ;;
        q|Q)
            exit 0
            ;;
        *)
            echo "Invalid choice. Returning to current list."
            return "$ACTION_SAME_LIST"
            ;;
    esac
}

probe_host_status_to_file() {
    local host="$1"
    local output_file="$2"

    get_reachability_status "$host" > "$output_file" || echo "UNREACHABLE" > "$output_file"
}

collect_host_statuses() {
    local -n hosts_ref=$1
    local -n statuses_ref=$2
    local tmpdir
    local -a pids
    local i host status_file status

    statuses_ref=()

    tmpdir=$(mktemp -d /tmp/fssh-status.XXXXXX)
    pids=()
    for i in "${!hosts_ref[@]}"; do
        host="${hosts_ref[$i]}"
        status_file="$tmpdir/$i.status"
        probe_host_status_to_file "$host" "$status_file" &
        pids+=("$!")
    done

    for pid in "${pids[@]}"; do
        wait "$pid" || true
    done

    for i in "${!hosts_ref[@]}"; do
        host="${hosts_ref[$i]}"
        status_file="$tmpdir/$i.status"
        status=$(cat "$status_file" 2>/dev/null || echo "UNKNOWN")
        statuses_ref+=("$status")
    done

    rm -rf "$tmpdir"
}

build_formatted_options() {
    local -n hosts_ref=$1
    local -n formatted_ref=$2
    local -n statuses_ref=$3
    local i

    formatted_ref=()

    for i in "${!hosts_ref[@]}"; do
        if [ "$SHOW_DETAILS" = true ] || [ -n "${statuses_ref[$i]:-}" ]; then
            formatted_ref+=("$(format_host_option "${hosts_ref[$i]}" "${statuses_ref[$i]:-}")")
        else
            formatted_ref+=("$(format_host_option "${hosts_ref[$i]}")")
        fi
    done
}

handle_all_hosts_unreachable() {
    print_actions_menu "Actions:" \
        "[r] refresh these hosts" \
        "[s] search again" \
        "[a] show all hosts" \
        "[q] quit"

    case "$(read_actions_choice "next-action")" in
        r|R|"")
            return "$ACTION_SAME_LIST"
            ;;
        s|S)
            prompt_new_search
            return "$ACTION_NEW_SEARCH"
            ;;
        a|A)
            SUBSTRING=""
            SHOW_ALL=true
            return "$ACTION_NEW_SEARCH"
            ;;
        q|Q)
            exit 0
            ;;
        *)
            echo -e "${YELLOW}Invalid choice. Refreshing the current host set.${NC}"
            return "$ACTION_SAME_LIST"
            ;;
    esac
}

# Interactive menu using fzf or fallback
interactive_menu() {
    local options formatted_options selected selected_host result
    local probed_statuses probe_everything reachable_count i
    local reachable_options reachable_statuses unreachable_options

    while true; do
        mapfile -t options < <(produce_weighted_list)

        print_banner
        print_network_status

        if [ ${#options[@]} -eq 0 ]; then
            echo -e "${YELLOW}No matching hosts found for query: ${SUBSTRING:-ALL}${NC}"
            prompt_new_search
            continue
        fi

        probe_everything=false
        if [ "$SHOW_DETAILS" = true ] || [ ${#options[@]} -gt 1 ]; then
            probe_everything=true
        fi

        probed_statuses=()
        if [ "$probe_everything" = true ]; then
            if [ "$SHOW_DETAILS" = true ]; then
                build_formatted_options options formatted_options probed_statuses
                formatted_options=()
                for i in "${!options[@]}"; do
                    formatted_options+=("$(format_host_option "${options[$i]}" "PROBING")")
                done
                print_host_list "DISCOVERY // ${#options[@]} MATCHED HOST(S)" "${formatted_options[@]}"
                echo -e "${GRAY}running parallel reachability probes...${NC}"
            fi

            collect_host_statuses options probed_statuses
        fi

        if [ ${#options[@]} -gt 1 ]; then
            reachable_count=0
            reachable_options=()
            reachable_statuses=()
            unreachable_options=()

            for i in "${!options[@]}"; do
                if is_connectable_status "${probed_statuses[$i]:-UNREACHABLE}"; then
                    reachable_options+=("${options[$i]}")
                    reachable_statuses+=("${probed_statuses[$i]}")
                    reachable_count=$((reachable_count + 1))
                else
                    unreachable_options+=("$(format_host_option "${options[$i]}" "${probed_statuses[$i]:-UNREACHABLE}")")
                fi
            done

            if [ "$reachable_count" -eq 0 ]; then
                build_formatted_options options formatted_options probed_statuses
                print_host_list "PROBE RESULT // ${#options[@]} MATCHED, 0 REACHABLE" "${formatted_options[@]}"
                result=0
                handle_all_hosts_unreachable || result=$?
                if [ "$result" -eq "$ACTION_NEW_SEARCH" ]; then
                    continue
                fi
                continue
            fi

            if [ "$reachable_count" -lt "${#options[@]}" ]; then
                echo -e "${YELLOW}${#options[@]} hosts matched, ${reachable_count} reachable. Unreachable hosts were skipped for connection.${NC}"
                if [ "$SHOW_DETAILS" = true ] && [ ${#unreachable_options[@]} -gt 0 ]; then
                    print_host_list "SKIPPED // UNREACHABLE HOST(S)" "${unreachable_options[@]}"
                fi
            fi

            options=("${reachable_options[@]}")
            probed_statuses=("${reachable_statuses[@]}")
        fi

        build_formatted_options options formatted_options probed_statuses

        if [ "$LIST_ONLY" = true ]; then
            if [ "$SHOW_DETAILS" != true ] && [ ${#probed_statuses[@]} -eq 0 ]; then
                print_host_list "DISCOVERY // ${#options[@]} MATCHED HOST(S)" "${formatted_options[@]}"
            else
                print_host_list "PROBE RESULT // FINAL HOST STATUS" "${formatted_options[@]}"
            fi
            exit 0
        fi

        # If fzf is available and either auto or forced
        if has_fzf || [ "$FORCE_FZF" = true ]; then
            if ! has_fzf && [ "$FORCE_FZF" = true ]; then
                echo -e "${RED}fzf forced but not found. Install fzf or remove -f.${NC}"
                exit 1
            fi

            while true; do
                # Fixed to use {1} for fzf natively extracting the first column without causing shell eval errors
                selected=$(printf "%s\n" "${formatted_options[@]}" | fzf --ansi --prompt "${CYAN}fssh-select> ${NC}" --preview "awk -v h={1} '\$1==\"Host\" && \$2==h {found=1; next} found { if(\$1==\"HostName\") print \"HostName: \"\$2; if(\$1==\"User\") print \"User: \"\$2; if(\$1==\"Port\") print \"Port: \"\$2; if(\$1==\"ProxyJump\") print \"ProxyJump: \"\$2; if(\$1==\"Host\") exit }' \"$SSH_CONFIG\"" --height 40% --layout=reverse --border)

                if [ -z "$selected" ]; then
                    echo -e "${GRAY}Session cancelled.${NC}"
                    exit 0
                fi

                selected_host=$(extract_host_name "$selected")
                result=0
                attempt_connect_loop "$selected_host" || result=$?

                if [ "$result" -eq "$ACTION_NEW_SEARCH" ]; then
                    break
                fi
            done
        else
            # Fallback: menu using select and while loop (TTY required)
            if [ "$SHOW_DETAILS" != true ]; then
                print_host_list "DISCOVERY // ${#options[@]} MATCHED HOST(S)" "${formatted_options[@]}"
            else
                print_section_title "PROBE RESULT // FINAL HOST STATUS"
            fi
            printf -v PS3 $'\n'"${CYAN}"'fssh-select> '"${NC}"

            while true; do
                select opt in "${formatted_options[@]}"; do
                    if [[ "$REPLY" =~ ^[Qq]$ ]]; then
                        echo -e "${GRAY}Session cancelled.${NC}"; exit 0
                    fi
                    if [ -z "$opt" ]; then
                        echo -e "${RED}Invalid option. Please try again.${NC}"
                        continue
                    fi
                    selected_host=$(extract_host_name "$opt")
                    result=0
                    attempt_connect_loop "$selected_host" || result=$?
                    if [ "$result" -eq "$ACTION_NEW_SEARCH" ]; then
                        break 2
                    fi
                    break
                done
            done
        fi
    done
}

# Loop for connection attempts and reconnect logic
attempt_connect_loop() {
    local selected_host="$1"
    local reachability_status exit_code

    while true; do
        print_section_title "CONNECT"
        echo -e "${WHITE}Target${NC}    : ${CYAN}${selected_host}${NC}"
        echo -e "${WHITE}Timestamp${NC} : ${GRAY}$(get_now)${NC}"

        reachability_status=$(get_reachability_status "$selected_host")
        echo -e "${WHITE}Probe${NC}     : $(format_status_label "$reachability_status")"

        if ! is_connectable_status "$reachability_status"; then
            echo -e "${YELLOW}Host ${selected_host} is not reachable right now. Returning to host selection.${NC}"
            return 1
        fi

        # Pre-ping
        if [ "$PRE_PING" = true ]; then
            if ping_host "$selected_host"; then
                echo -e "${WHITE}Preflight${NC} : ${GREEN}PING-OK${NC}"
            else
                echo -e "${WHITE}Preflight${NC} : ${YELLOW}PING-NO-REPLY${NC}"
            fi
        fi

        ssh "$selected_host"
        exit_code=$?
        if [ $exit_code -eq 0 ]; then
            # success
            local post_disconnect_result=0
            increment_history "$selected_host"
            print_section_title "DISCONNECT"
            echo -e "${WHITE}Target${NC}    : ${CYAN}${selected_host}${NC}"
            echo -e "${WHITE}Timestamp${NC} : ${GRAY}$(get_now)${NC}"
            handle_post_disconnect || post_disconnect_result=$?
            return "$post_disconnect_result"
        fi

        print_section_title "CONNECT-ERROR"
        echo -e "${WHITE}Exit Code${NC} : ${RED}${exit_code}${NC}"
        # offer options: try another host, retry same, or quit
        print_actions_menu "Actions:" \
            "[r] retry this host" \
            "[a] back to host list" \
            "[q] quit"
        choice=$(read_actions_choice "retry-action")
        case "$choice" in
            r|R)
                echo -e "${GRAY}re-queueing target ${selected_host}${NC}"
                continue
                ;;
            a|A)
                # try another host -> return non-zero so caller will show menu again
                return 1
                ;;
            q|Q)
                exit $exit_code
                ;;
            *)
                echo "Invalid choice. Exiting."; exit $exit_code
                ;;
        esac
    done
}

# Main
interactive_menu

# End of script
