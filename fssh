#!/usr/bin/env bash
# fssh_refactor.sh
# Refactored Enhanced SSH host selector
# Features:
# - fzf fuzzy finder (optional, auto used when available)
# - history weighting (hosts used more often float up)
# - preview host details (HostName) in fzf preview
# - auto-ping before ssh (optional)
# - reconnection logic with full menu reprint
# - graceful fallbacks when fzf not available
# - supports options: -i (case-insensitive), -l (list-only), -a (show-all), -d (details), -f (force fzf), -p (pre-ping), -h (help), --fullscreen

set -euo pipefail
IFS=$'\n\t'

# Colors (Fixed to use ANSI C-quoting for proper raw byte evaluation in prompts)
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
CYAN=$'\033[0;36m'
GRAY=$'\033[0;90m'
WHITE=$'\033[1;37m'
BOLD=$'\033[1m'
NC=$'\033[0m'

# Defaults
SSH_CONFIG="$HOME/.ssh/config"
HISTORY_FILE="$HOME/.fssh_history"
MAX_HISTORY=50
USE_FZF_AUTO=true
FORCE_FZF=false
PRE_PING=false
CASE_INSENSITIVE=false
LIST_ONLY=false
SHOW_ALL=false
SHOW_DETAILS=false
SUBSTRING=""
ACTION_SAME_LIST=0
ACTION_NEW_SEARCH=10
APP_SCREEN_ACTIVE=false
FULLSCREEN=false
SELECTOR_MODE="basic"

case "${FSSH_FULLSCREEN:-0}" in
    1|true|TRUE|yes|YES|on|ON)
        FULLSCREEN=true
        ;;
esac

get_now() {
    date '+%Y-%m-%d %H:%M:%S %Z'
}

enter_app_screen() {
    if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
        if command -v tput >/dev/null 2>&1; then
            tput smcup 2>/dev/null || true
            tput clear 2>/dev/null || true
        else
            printf '\033[?1049h\033[H\033[2J'
        fi
        APP_SCREEN_ACTIVE=true
    fi
}

refresh_app_screen() {
    if [ "$APP_SCREEN_ACTIVE" = true ]; then
        if command -v tput >/dev/null 2>&1; then
            tput clear 2>/dev/null || true
        else
            printf '\033[H\033[2J'
        fi
    fi
}

exit_app_screen() {
    if [ "$APP_SCREEN_ACTIVE" = true ]; then
        if command -v tput >/dev/null 2>&1; then
            tput rmcup 2>/dev/null || true
        else
            printf '\033[?1049l'
        fi
        APP_SCREEN_ACTIVE=false
    fi
}

print_banner() {
    print_console_header
    echo
}

format_status_label() {
    local raw_status="$1"
    local status label

    status=$(status_name "$raw_status")
    label=$(status_display_text "$raw_status")

    case "$status" in
        SSH-READY) printf "%b%s%b" "$GREEN" "$label" "$NC" ;;
        ICMP-OK) printf "%b%s%b" "$YELLOW" "$label" "$NC" ;;
        PROBING) printf "%b%s%b" "$YELLOW" "$label" "$NC" ;;
        PORT-CLOSED|TIMEOUT|NO-ROUTE|DNS-FAIL|UNREACHABLE|UNKNOWN) printf "%b%s%b" "$RED" "$label" "$NC" ;;
        *) printf "%s" "$label" ;;
    esac
}

print_help() {
    cat <<EOF
Usage: $(basename "$0") [-i] [-l] [-a] [-d] [-f] [-p] [-h] [--fullscreen] <substring>
  -i  Case-insensitive search
  -l  List matches only (don't connect)
  -a  Show all hosts
  -d  Show details (HostName/IP + live network status)
  -f  Force fzf (fail if not available)
  -p  Pre-ping host before attempting ssh
  -h  Show this help
  --fullscreen  Use alternate-screen mode and clear/redraw the menu

This script also prints:
  - Current outbound IP address
  - Internet connectivity status

Examples:
  $(basename "$0") -i jenkins
  $(basename "$0") -a
  $(basename "$0") -f supeng
EOF
}

# Parse args
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --fullscreen)
            FULLSCREEN=true
            shift
            ;;
        --)
            shift
            args+=("$@")
            break
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
set -- "${args[@]}"

while getopts ":iladfph" opt; do
    case $opt in
        i) CASE_INSENSITIVE=true ;;
        l) LIST_ONLY=true ;;
        a) SHOW_ALL=true ;;
        d) SHOW_DETAILS=true ;;
        f) FORCE_FZF=true ;;
        p) PRE_PING=true ;;
        h) print_help; exit 0 ;;
        :) echo "Missing option argument for -$OPTARG" >&2; exit 1 ;;
        \?) echo "Unknown option -$OPTARG" >&2; print_help; exit 1 ;;
    esac
done
shift $((OPTIND-1))

# Substring if provided
if [ $# -gt 0 ]; then
    SUBSTRING="$1"
    case "$SUBSTRING" in
        all|ALL|All|"*"|".")
            SUBSTRING=""
            SHOW_ALL=true
            ;;
    esac
fi

# Validate files
if [ ! -f "$SSH_CONFIG" ]; then
    echo -e "${RED}Error: SSH config not found at $SSH_CONFIG${NC}"
    exit 1
fi

# Ensure history file exists
mkdir -p "$(dirname "$HISTORY_FILE")"
: >| "$HISTORY_FILE" 2>/dev/null || true

# Utility: get host list
get_hosts_raw() {
    awk '$1 == "Host" && $2 !~ /\*/ {print $2}' "$SSH_CONFIG"
}

get_hosts_filtered() {
    if [ "$SHOW_ALL" = true ]; then
        get_hosts_raw
        return
    fi

    if [ -z "$SUBSTRING" ]; then
        get_hosts_raw
        return
    fi

    if [ "$CASE_INSENSITIVE" = true ]; then
        awk -v pat="$SUBSTRING" 'BEGIN{IGNORECASE=1} $1=="Host" && $2 !~ /\*/ && $2 ~ pat {print $2}' "$SSH_CONFIG"
    else
        awk -v pat="$SUBSTRING" '$1=="Host" && $2 !~ /\*/ && $2 ~ pat {print $2}' "$SSH_CONFIG"
    fi
}

# Get details HostName for preview
get_host_hostname() {
    local h="$1"
    awk -v h="$h" '
        $1=="Host" && $2==h {found=1; next}
        found && $1=="HostName" {print $2; exit}
        found && $1=="Host" {exit}
    ' "$SSH_CONFIG"
}

get_host_port() {
    local h="$1"
    awk -v h="$h" '
        $1=="Host" && $2==h {found=1; next}
        found && $1=="Port" {print $2; exit}
        found && $1=="Host" {exit}
    ' "$SSH_CONFIG"
}

# Weighted sorting by history
# History file format: host|count (tab-separated or pipe), fallback to plain host lines if old
increment_history() {
    local host="$1"
    declare -A counts
    # read existing
    if [ -f "$HISTORY_FILE" ] && [ -s "$HISTORY_FILE" ]; then
        while IFS='|' read -r hh cnt; do
            if [ -z "$cnt" ]; then
                # old style: just host lines
                counts["$hh"]=$((counts["$hh"]+1))
            else
                counts["$hh"]=$cnt
            fi
        done < "$HISTORY_FILE"
    fi
    counts["$host"]=$(( ${counts["$host"]:-0} + 1 ))

    # write back sorted by count desc
    >"${HISTORY_FILE}.tmp"
    for k in "${!counts[@]}"; do
        echo "$k|${counts[$k]}" >> "${HISTORY_FILE}.tmp"
    done
    # sort numerically by second field desc
    sort -t'|' -k2,2nr "${HISTORY_FILE}.tmp" > "$HISTORY_FILE"
    rm -f "${HISTORY_FILE}.tmp"
}

# Produce weighted host list: hosts that appear in history higher
produce_weighted_list() {
    local -a raw
    mapfile -t raw < <(get_hosts_filtered)

    # read history into order
    declare -A rank
    local idx=0
    if [ -f "$HISTORY_FILE" ]; then
        while IFS='|' read -r hh cnt; do
            rank["$hh"]=$((100000 - idx))
            idx=$((idx+1))
        done < "$HISTORY_FILE"
    fi

    # prepare sortable lines: score<tab>host
    for h in "${raw[@]}"; do
        score=${rank["$h"]:-0}
        echo -e "$score\t$h"
    done | sort -k1,1nr | awk -F"\t" '{print $2}'
}

# Check fzf availability
has_fzf() {
    command -v fzf >/dev/null 2>&1
}

# Ping host helper
ping_host() {
    local target="$1"
    # try HostName first
    local hn
    hn=$(get_host_hostname "$target")
    local ip_or_host=${hn:-$target}
    if ping -c 1 -W 1 "$ip_or_host" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

get_host_target() {
    local host="$1"
    local hn

    hn=$(get_host_hostname "$host")
    echo "${hn:-$host}"
}

current_millis() {
    local now

    now=$(date +%s%3N 2>/dev/null || date +%s)
    case "$now" in
        *N*) printf "%s000\n" "$(date +%s)" ;;
        *) printf "%s\n" "$now" ;;
    esac
}

emit_probe_status() {
    local status="$1"
    local started_at="$2"
    local finished_at elapsed

    finished_at=$(current_millis)
    elapsed=$((finished_at - started_at))
    if [ "$elapsed" -lt 0 ]; then
        elapsed=0
    fi

    printf "%s|%s\n" "$status" "$elapsed"
}

status_name() {
    local raw_status="$1"
    printf "%s" "${raw_status%%|*}"
}

status_latency() {
    local raw_status="$1"

    if [[ "$raw_status" == *"|"* ]]; then
        printf "%s" "${raw_status#*|}"
    fi
}

status_display_text() {
    local status

    status=$(status_name "$1")
    case "$status" in
        SSH-READY) printf "SSH-READY" ;;
        ICMP-OK) printf "ICMP-OK" ;;
        PROBING) printf "PROBING" ;;
        *) printf "DOWN" ;;
    esac
}

latency_display_text() {
    local raw_status="$1"
    local status latency

    status=$(status_name "$raw_status")
    latency=$(status_latency "$raw_status")

    case "$status" in
        SSH-READY|ICMP-OK)
            if [ -n "$latency" ]; then
                printf "%sms" "$latency"
            else
                printf "%s" "---"
            fi
            ;;
        TIMEOUT)
            printf "TIMEOUT"
            ;;
        PROBING)
            printf "%s" "---"
            ;;
        *)
            printf "%s" "---"
            ;;
    esac
}

colorize_probe_value() {
    local raw_status="$1"
    local text="$2"
    local status

    status=$(status_name "$raw_status")
    case "$status" in
        SSH-READY) printf "%b%s%b" "$GREEN" "$text" "$NC" ;;
        ICMP-OK) printf "%b%s%b" "$YELLOW" "$text" "$NC" ;;
        PROBING) printf "%b%s%b" "$YELLOW" "$text" "$NC" ;;
        PORT-CLOSED|TIMEOUT|NO-ROUTE|DNS-FAIL|UNREACHABLE|UNKNOWN) printf "%b%s%b" "$RED" "$text" "$NC" ;;
        *) printf "%s" "$text" ;;
    esac
}

get_reachability_status() {
    local host="$1"
    local target port probe_output started_at

    target=$(get_host_target "$host")
    port=$(get_host_port "$host")
    port=${port:-22}

    if command -v nc >/dev/null 2>&1; then
        started_at=$(current_millis)
        if probe_output=$(nc -z -w 1 "$target" "$port" 2>&1 >/dev/null); then
            emit_probe_status "SSH-READY" "$started_at"
            return
        fi

        case "$probe_output" in
            *"Connection refused"*)
                emit_probe_status "PORT-CLOSED" "$started_at"
                return
                ;;
            *"No route to host"*|*"Network is unreachable"*)
                emit_probe_status "NO-ROUTE" "$started_at"
                return
                ;;
            *"timed out"*|*"Operation timed out"*)
                emit_probe_status "TIMEOUT" "$started_at"
                return
                ;;
            *"Name or service not known"*|*"Temporary failure in name resolution"*|*"nodename nor servname provided, or not known"*)
                emit_probe_status "DNS-FAIL" "$started_at"
                return
                ;;
        esac
    fi

    if command -v ping >/dev/null 2>&1; then
        started_at=$(current_millis)
        if ping -c 1 -W 1 "$target" >/dev/null 2>&1; then
            emit_probe_status "ICMP-OK" "$started_at"
            return
        fi

        emit_probe_status "UNREACHABLE" "$started_at"
        return
    fi

    echo "UNREACHABLE"
}

is_connectable_status() {
    local status

    status=$(status_name "$1")

    case "$status" in
        SSH-READY|ICMP-OK)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

format_host_option() {
    local host="$1"
    local status="${2:-}"
    local index="${3:-}"
    local target latency_text padded_latency status_text rendered_latency rendered_status id

    id="-"
    if [ -n "$index" ]; then
        id="[$index]"
    fi

    target=$(get_host_target "$host")
    target=${target:-unknown}
    latency_text=$(latency_display_text "${status:-UNKNOWN}")
    status_text=$(status_display_text "${status:-UNKNOWN}")
    printf -v padded_latency "%8s" "$latency_text"
    rendered_latency=$(colorize_probe_value "${status:-UNKNOWN}" "$padded_latency")
    rendered_status=$(colorize_probe_value "${status:-UNKNOWN}" "$status_text")

    printf "%-5s %-24.24s %-16.16s %b   %b\n" "$id" "$host" "$target" "$rendered_latency" "$rendered_status"
}

extract_host_name() {
    local entry="$1"

    awk '{print $2}' <<< "$entry"
}

get_current_ip() {
    local current_ip=""

    if command -v ip >/dev/null 2>&1; then
        current_ip=$(ip route get 1.1.1.1 2>/dev/null | awk '
            /src/ {
                for (i = 1; i <= NF; i++) {
                    if ($i == "src" && (i + 1) <= NF) {
                        print $(i + 1)
                        exit
                    }
                }
            }'
        )
    fi

    if [ -z "$current_ip" ] && command -v hostname >/dev/null 2>&1; then
        current_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    fi

    if [ -z "$current_ip" ] && command -v ifconfig >/dev/null 2>&1; then
        current_ip=$(ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" {print $2; exit}')
    fi

    echo "${current_ip:-unknown}"
}

has_internet_connection() {
    if command -v ping >/dev/null 2>&1; then
        ping -c 1 -W 1 1.1.1.1 >/dev/null 2>&1 && return 0
        ping -c 1 -W 1 8.8.8.8 >/dev/null 2>&1 && return 0
    fi

    return 1
}

get_filter_label() {
    if [ "$SHOW_ALL" = true ] || [ -z "$SUBSTRING" ]; then
        printf "ALL"
    else
        printf "%s" "$SUBSTRING"
    fi
}

get_internet_status_label() {
    if has_internet_connection; then
        printf "Connected"
    else
        printf "Not connected"
    fi
}

print_console_header() {
    local current_ip internet_status internet_color filter_label

    current_ip=$(get_current_ip)
    internet_status=$(get_internet_status_label)
    internet_color="$GREEN"
    if [ "$internet_status" != "Connected" ]; then
        internet_color="$RED"
    fi
    filter_label=$(get_filter_label)

    printf "%bFSSH //%b %b%s%b %b•%b %b%s%b %b•%b %s %b•%b %s\n" \
        "$CYAN$BOLD" "$NC" \
        "$CYAN" "$current_ip" "$NC" \
        "$GRAY" "$NC" \
        "$internet_color" "$internet_status" "$NC" \
        "$GRAY" "$NC" \
        "$SELECTOR_MODE" \
        "$GRAY" "$NC" \
        "$(get_now)"
    printf "Filter: %b%s%b\n" "$YELLOW" "$filter_label" "$NC"
}

build_table_header() {
    printf "%-5s %-24s %-16s %8s   %s\n" "ID" "HOST" "ADDRESS" "LATENCY" "STATUS"
}

build_fzf_header() {
    printf "FSSH // %s • %s • %s • %s\n" "$(get_current_ip)" "$(get_internet_status_label)" "$SELECTOR_MODE" "$(get_now)"
    printf "Filter: %s\n\n" "$(get_filter_label)"
    build_table_header
}

print_host_list() {
    local title="$1"
    shift
    local row

    print_console_header
    echo
    build_table_header
    for row in "$@"; do
        printf "%b\n" "$row"
    done
}

print_actions_menu() {
    local title="$1"
    local IFS=" "
    shift

    echo
    printf "%b%s%b %s\n" "$WHITE" "$title" "$NC" "$*"
}

read_actions_choice() {
    local prompt_label="${1:-select}"
    local choice

    printf "%b" "${CYAN}${prompt_label} > ${NC}" >&2
    read -r choice
    echo "$choice"
}

prompt_new_search() {
    local new_search

    printf "%b" "${CYAN}filter > ${NC}"
    read -r new_search
    if [[ "$new_search" =~ ^[Qq]$ ]]; then
        exit 0
    fi
    set_search_filter "$new_search"
}

set_search_filter() {
    local new_search="$1"

    case "$new_search" in
        ""|all|ALL|All|"*"|".")
            SUBSTRING=""
            SHOW_ALL=true
            ;;
        *)
            SUBSTRING="$new_search"
            SHOW_ALL=false
            ;;
    esac
}

handle_post_disconnect() {
    local choice search_query

    print_actions_menu "Next:" "[l] list" "[q] quit" "or type filter"
    choice=$(read_actions_choice "next")
    case "$choice" in
        l|L|"")
            return "$ACTION_SAME_LIST"
            ;;
        s|S)
            prompt_new_search
            return "$ACTION_NEW_SEARCH"
            ;;
        s\ *|S\ *)
            search_query="${choice#* }"
            set_search_filter "$search_query"
            return "$ACTION_NEW_SEARCH"
            ;;
        q|Q)
            exit 0
            ;;
        *)
            set_search_filter "$choice"
            return "$ACTION_NEW_SEARCH"
            ;;
    esac
}

probe_host_status_to_file() {
    local host="$1"
    local output_file="$2"

    get_reachability_status "$host" > "$output_file" || echo "UNREACHABLE" > "$output_file"
}

collect_host_statuses() {
    local -n hosts_ref=$1
    local -n statuses_ref=$2
    local tmpdir
    local -a pids
    local i host status_file status

    statuses_ref=()

    tmpdir=$(mktemp -d /tmp/fssh-status.XXXXXX)
    pids=()
    for i in "${!hosts_ref[@]}"; do
        host="${hosts_ref[$i]}"
        status_file="$tmpdir/$i.status"
        probe_host_status_to_file "$host" "$status_file" &
        pids+=("$!")
    done

    for pid in "${pids[@]}"; do
        wait "$pid" || true
    done

    for i in "${!hosts_ref[@]}"; do
        host="${hosts_ref[$i]}"
        status_file="$tmpdir/$i.status"
        status=$(cat "$status_file" 2>/dev/null || echo "UNKNOWN")
        statuses_ref+=("$status")
    done

    rm -rf "$tmpdir"
}

build_formatted_options() {
    local -n hosts_ref=$1
    local -n formatted_ref=$2
    local -n statuses_ref=$3
    local i

    formatted_ref=()

    for i in "${!hosts_ref[@]}"; do
        if [ "$SHOW_DETAILS" = true ] || [ -n "${statuses_ref[$i]:-}" ]; then
            formatted_ref+=("$(format_host_option "${hosts_ref[$i]}" "${statuses_ref[$i]:-}" "$((i + 1))")")
        else
            formatted_ref+=("$(format_host_option "${hosts_ref[$i]}" "" "$((i + 1))")")
        fi
    done
}

# Interactive menu using fzf or fallback
interactive_menu() {
    local options formatted_options selected selected_host result choice
    local probed_statuses

    while true; do
        mapfile -t options < <(produce_weighted_list)

        refresh_app_screen

        if [ ${#options[@]} -eq 0 ]; then
            print_banner
            echo -e "${YELLOW}No matches for:${NC} ${SUBSTRING:-ALL}"
            echo -e "${GRAY}Type another filter, all, *, or q.${NC}"
            prompt_new_search
            continue
        fi

        probed_statuses=()
        collect_host_statuses options probed_statuses

        if [ "$LIST_ONLY" = true ]; then
            build_formatted_options options formatted_options probed_statuses
            if [ "$SHOW_DETAILS" != true ] && [ ${#probed_statuses[@]} -eq 0 ]; then
                print_host_list "HOSTS" "${formatted_options[@]}"
            else
                print_host_list "HOSTS" "${formatted_options[@]}"
            fi
            exit 0
        fi

        build_formatted_options options formatted_options probed_statuses

        # If fzf is available and either auto or forced
        if has_fzf || [ "$FORCE_FZF" = true ]; then
            if ! has_fzf && [ "$FORCE_FZF" = true ]; then
                echo -e "${RED}fzf forced but not found. Install fzf or remove -f.${NC}"
                exit 1
            fi

            SELECTOR_MODE="fzf"
            while true; do
                selected=$(printf "%s\n" "${formatted_options[@]}" | fzf --ansi --prompt "${CYAN}fssh-select > ${NC}" --header "$(build_fzf_header)" --preview "awk -v h={2} '\$1==\"Host\" && \$2==h {found=1; next} found { if(\$1==\"HostName\") print \"HostName: \"\$2; if(\$1==\"User\") print \"User: \"\$2; if(\$1==\"Port\") print \"Port: \"\$2; if(\$1==\"ProxyJump\") print \"ProxyJump: \"\$2; if(\$1==\"Host\") exit }' \"$SSH_CONFIG\"" --height 40% --layout=reverse --border)

                if [ -z "$selected" ]; then
                    echo -e "${GRAY}Session cancelled.${NC}"
                    exit 0
                fi

                selected_host=$(extract_host_name "$selected")
                result=0
                attempt_connect_loop "$selected_host" || result=$?

                if [ "$result" -eq "$ACTION_NEW_SEARCH" ]; then
                    break
                fi
            done
        else
            SELECTOR_MODE="basic"
            print_host_list "HOSTS" "${formatted_options[@]}"
            while true; do
                choice=$(read_actions_choice "fssh-select")
                if [[ "$choice" =~ ^[Qq]$ ]]; then
                    echo -e "${GRAY}Session cancelled.${NC}"
                    exit 0
                fi
                if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#options[@]}" ]; then
                    echo -e "${RED}Invalid option. Please try again.${NC}"
                    continue
                fi

                selected_host="${options[$((choice - 1))]}"
                result=0
                attempt_connect_loop "$selected_host" || result=$?
                if [ "$result" -eq "$ACTION_NEW_SEARCH" ]; then
                    break 2
                fi
                break
            done
        fi
    done
}

# Loop for connection attempts and reconnect logic
attempt_connect_loop() {
    local selected_host="$1"
    local reachability_status exit_code choice post_disconnect_result target_address

    while true; do
        target_address=$(get_host_target "$selected_host")

        reachability_status=$(get_reachability_status "$selected_host")
        if ! is_connectable_status "$reachability_status"; then
            printf "%bConnection Failed:%b %s (%s) is unreachable. [%b]\n" \
                "$RED" "$NC" "$selected_host" "$target_address" "$(format_status_label "$reachability_status")"
            return 1
        fi

        if [ "$PRE_PING" = true ]; then
            if ping_host "$selected_host"; then
                printf "Preflight: %bPING-OK%b\n" "$GREEN" "$NC"
            else
                printf "Preflight: %bPING-NO-REPLY%b\n" "$YELLOW" "$NC"
            fi
        fi

        printf "%bConnecting to%b %s (%s)...\n" "$YELLOW" "$NC" "$selected_host" "$target_address"
        exit_code=0
        ssh "$selected_host" || exit_code=$?
        if [ $exit_code -eq 0 ]; then
            increment_history "$selected_host"
            post_disconnect_result=0
            printf "%bDisconnected:%b %s (%s)\n" "$GREEN" "$NC" "$selected_host" "$target_address"
            handle_post_disconnect || post_disconnect_result=$?
            return "$post_disconnect_result"
        fi

        printf "%bConnection Failed:%b %s exited with code %s.\n" "$RED" "$NC" "$selected_host" "$exit_code"
        print_actions_menu "Next:" "[r] retry" "[a] list" "[q] quit"
        choice=$(read_actions_choice "retry")
        case "$choice" in
            r|R)
                echo -e "${GRAY}re-queueing target ${selected_host}${NC}"
                continue
                ;;
            a|A)
                # try another host -> return non-zero so caller will show menu again
                return 1
                ;;
            q|Q)
                exit $exit_code
                ;;
            *)
                echo "Invalid choice. Exiting."; exit $exit_code
                ;;
        esac
    done
}

# Main
if [ "$LIST_ONLY" != true ] && [ "$FULLSCREEN" = true ]; then
    enter_app_screen
    trap exit_app_screen EXIT
fi

interactive_menu

# End of script
